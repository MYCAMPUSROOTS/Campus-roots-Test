<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/courseContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical">

    <!-- Left-side: Course Code Circle -->
    <LinearLayout
        android:layout_width="50dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:layout_marginEnd="16dp">

        <ImageView
            android:id="@+id/isActive"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:background="@drawable/rounded_circle"
            android:src="@drawable/rounded_circle"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/courseCode"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="MTH 101"
            android:textColor="#1E88E5"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="visible" />
    </LinearLayout>

    <!-- Right-side: Course Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Course Title -->

        <!-- Instructor and Channels -->
        <TextView
            android:id="@+id/courseTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student Elementary Mathematics TA"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <!-- Instructor Name -->
            <TextView
                android:id="@+id/courseLecturer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#888888"
                android:text="Markus Callaway" />

            <!-- Channels count -->
            <TextView
                android:id="@+id/courseChannels"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="14sp"
                android:textColor="#888888"
                android:text="7 Channels" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
